generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes", "views"]
}

datasource db {
  provider = "postgresql"
}

model notifications {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  type       String
  body       String
  payload    Json      @default("{}")
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  read_at    DateTime? @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "notifications_unread", where: raw("(read_at IS NULL)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  order_id BigInt
  snack_id BigInt
  quantity Int
  price    Decimal? @db.Decimal(12, 2)
  total    Decimal? @db.Decimal(12, 2)
  orders   orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  snacks   snacks   @relation(fields: [snack_id], references: [id], onUpdate: NoAction)

  @@id([order_id, snack_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_payments {
  order_id       BigInt
  payment_id     BigInt
  amount_applied Decimal  @db.Decimal(12, 2)
  orders         orders   @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  payments       payments @relation(fields: [payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([order_id, payment_id])
  @@index([payment_id], map: "order_payments_by_payment")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id               BigInt           @id @default(autoincrement())
  user_id          BigInt
  status           order_status     @default(PENDING)
  estimated_total  Decimal          @db.Decimal(12, 2)
  total            Decimal?         @db.Decimal(12, 2)
  fulfillment_date DateTime?        @db.Date
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  accepted_at      DateTime?        @db.Timestamptz(6)
  rejected_at      DateTime?        @db.Timestamptz(6)
  cancelled_at     DateTime?        @db.Timestamptz(6)
  completed_at     DateTime?        @db.Timestamptz(6)
  order_items      order_items[]
  order_payments   order_payments[]
  users            users            @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([status, fulfillment_date], map: "orders_admin_queue", where: raw("(status = ANY (ARRAY['PENDING'::order_status, 'ACCEPTED'::order_status]))"))
  @@index([user_id, status], map: "orders_by_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payment_amendments {
  id         BigInt   @id @default(autoincrement())
  payment_id BigInt
  old_amount Decimal  @db.Decimal(12, 2)
  new_amount Decimal  @db.Decimal(12, 2)
  reason     String
  amended_by BigInt
  amended_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [amended_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments   payments @relation(fields: [payment_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id                 BigInt               @id @default(autoincrement())
  user_id            BigInt
  reported_amount    Decimal              @db.Decimal(12, 2)
  received_amount    Decimal?             @db.Decimal(12, 2)
  status             payment_status       @default(PENDING_CONFIRMATION)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  confirmed_at       DateTime?            @db.Timestamptz(6)
  order_payments     order_payments[]
  payment_amendments payment_amendments[]
  users              users                @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([user_id, status], map: "payments_by_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model settings {
  id         Boolean   @id @default(true)
  work_days  weekday[]
  cutoff     DateTime  @default(dbgenerated("'09:00:00'::time without time zone")) @db.Time(6)
  timezone   String    @default("Africa/Lagos")
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model snacks {
  id           BigInt        @id @default(autoincrement())
  name         String        @unique
  price        Decimal       @db.Decimal(12, 2)
  is_available Boolean       @default(true)
  is_retired   Boolean       @default(false)
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  order_items  order_items[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id                 BigInt               @id @default(autoincrement())
  first_name         String
  last_name          String
  email              String               @unique
  password_hash      String
  is_admin           Boolean              @default(false)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  notifications      notifications[]
  orders             orders[]
  payment_amendments payment_amendments[]
  payments           payments[]
}

view order_settlement {
  order_id         BigInt?
  user_id          BigInt?
  status           order_status?
  total            Decimal?      @db.Decimal(12, 2)
  fulfillment_date DateTime?     @db.Date
  applied          Decimal?      @db.Decimal
  outstanding      Decimal?      @db.Decimal
}

view chase_list {
  first_name       String?
  last_name        String?
  email            String?
  order_id         BigInt?
  fulfillment_date DateTime? @db.Date
  outstanding      Decimal?  @db.Decimal
}

enum order_status {
  PENDING
  ACCEPTED
  COMPLETED
  REJECTED
  CANCELLED
}

enum payment_status {
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
}

enum weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}
